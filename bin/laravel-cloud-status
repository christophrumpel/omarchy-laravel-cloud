#!/bin/bash
# Print a compact JSON snapshot of every Laravel Cloud application, its
# environments and each environment's latest deployment. The snapshot is also
# cached in the state dir so the panel can paint instantly after a shell start.
#
# When the CLI holds tokens for several organizations, every organization is
# queried and the apps are merged; each app carries the position of the token
# it belongs to (tokenIndex) so later actions can address the same organization.
#
# Output shape:
#   { "fetchedAt": iso, "error": null|string, "code": null|string,
#     "setup": {phpVersion,phpOk,composerOk,cliOk,cliPath},
#     "organizations": [ {id,name,slug,tokenIndex} ],
#     "apps": [ { id, name, slug, region, repositoryFullName, repositoryBranch,
#       organization: {id,name,slug}, tokenIndex,
#       environments: [ { id, name, slug, status, url, latest: { id, status,
#         commitMessage, commitHash, branchName, startedAt, finishedAt,
#         failureReason } | null } ] } ] }

set -o pipefail
source "$(dirname "$(readlink -f "$0")")/laravel-cloud-lib"

CACHE="$STATE_DIR/status.json"
NOW=$(date -u +%FT%TZ)
CLOUD_TIMEOUT=90
PHP_VERSION=$(php_version)
PHP_OK=false
php_supported && PHP_OK=true
COMPOSER_OK=false
command -v composer >/dev/null 2>&1 && COMPOSER_OK=true
SETUP=$(jq -cn --arg phpVersion "$PHP_VERSION" --argjson phpOk "$PHP_OK" \
  --argjson composerOk "$COMPOSER_OK" --argjson cliOk "$CLOUD_OK" --arg cliPath "$CLOUD_BIN" \
  '{phpVersion:$phpVersion, phpOk:$phpOk, composerOk:$composerOk, cliOk:($cliOk == 1), cliPath:$cliPath}')

notify_setup() {
  notify-send -a "Laravel Cloud" "$1" "$2" 2>/dev/null || true
}

emit_error() {
  case ${2:-} in
    missing-php|missing-composer|missing-cli|cli-broken|unauthenticated)
      if [[ ! -f $STATE_DIR/setup-pending ]]; then
        touch "$STATE_DIR/setup-pending"
        notify_setup "Laravel Cloud needs setup" "Open the panel to continue."
      fi
      ;;
  esac
  jq -cn --arg now "$NOW" --arg err "$1" --arg code "${2:-}" --argjson setup "$SETUP" \
    '{fetchedAt:$now, error:$err, code:(if $code == "" then null else $code end), setup:$setup, organizations:[], apps:[]}'
  exit 0
}

if [[ ${1:-} == "--cached" ]]; then
  [[ -f $CACHE ]] && cat "$CACHE" && exit 0
  emit_error "no cached status yet"
fi

check_requirements() {
  [[ $PHP_OK == true ]] || emit_error "PHP 8.3 or newer is required." missing-php
  if [[ -n $CLOUD_BIN ]]; then
    (( CLOUD_OK )) || emit_error "The cloud CLI could not start." cli-broken
  else
    [[ $COMPOSER_OK == true ]] || emit_error "Composer is required to install the cloud CLI." missing-composer
    emit_error "The cloud CLI is not installed." missing-cli
  fi
}

check_requirements

# Which tokens to query: the environment token alone, or every stored token.
if [[ -n ${LARAVEL_CLOUD_TOKEN:-} ]]; then
  token_indexes=(env)
else
  count=$(stored_token_count)
  (( count > 0 )) || emit_error "Not signed in to Laravel Cloud." unauthenticated
  token_indexes=($(seq 0 $((count - 1))))
fi

# A rejected login should not trigger another API request on every setup poll.
# Store only a SHA-256 fingerprint, never the credentials. Changed credentials,
# an explicit refresh, or five elapsed minutes allow another attempt.
AUTH_RETRY="$STATE_DIR/auth-retry.json"
AUTH_FINGERPRINT=$(
  { if [[ -n ${LARAVEL_CLOUD_TOKEN:-} ]]; then
      printf '%s' "$LARAVEL_CLOUD_TOKEN"
    else
      stored_tokens
    fi
  } | sha256sum | cut -d ' ' -f 1
)
if [[ ${1:-} != --force && -n $AUTH_FINGERPRINT && -f $AUTH_RETRY ]]; then
  if jq -e --arg fingerprint "$AUTH_FINGERPRINT" --argjson now "$(date +%s)" \
    '.fingerprint == $fingerprint and .retryAfter > $now' "$AUTH_RETRY" >/dev/null 2>&1; then
    emit_error "$(jq -r '.message' "$AUTH_RETRY")" "$(jq -r '.code' "$AUTH_RETRY")"
  fi
fi

emit_auth_error() {
  if [[ -n $AUTH_FINGERPRINT ]]; then
    jq -cn --arg fingerprint "$AUTH_FINGERPRINT" --arg message "$1" --arg code "${2:-}" \
      --argjson retryAfter "$(($(date +%s) + 300))" \
      '{fingerprint:$fingerprint, retryAfter:$retryAfter, message:$message, code:$code}' >"$AUTH_RETRY"
  fi
  emit_error "$@"
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

APP_FIELDS="id,name,slug,region,repositoryFullName,repositoryBranch,organization.id,organization.name,organization.slug,environments.id,environments.name,environments.slug,environments.status,environments.url"
DEPLOY_FIELDS="id,status,commitMessage,commitHash,branchName,startedAt,finishedAt,failureReason"

# One application:list per organization, in parallel.
for idx in "${token_indexes[@]}"; do
  (
    [[ $idx == env ]] || use_token_index "$idx"
    if out=$(run_cloud application:list --json --fields="$APP_FIELDS") && jq -e 'type == "array"' <<<"$out" >/dev/null 2>&1; then
      jq -c --arg idx "$idx" 'map(. + {tokenIndex: (if $idx == "env" then -1 else ($idx | tonumber) end)})' <<<"$out" >"$tmp/apps-$idx.json"
    else
      cloud_error_message "$out" >"$tmp/apps-$idx.err"
    fi
  ) &
done
wait

apps='[]'
for f in "$tmp"/apps-*.json; do
  [[ -f $f ]] || continue
  apps=$(jq -c --slurpfile more "$f" '. + $more[0]' <<<"$apps")
done

if [[ $apps == '[]' ]]; then
  err_file=$(ls "$tmp"/apps-*.err 2>/dev/null | head -n1)
  msg=$([[ -n $err_file ]] && cat "$err_file")
  if [[ -n $err_file ]]; then
    case $msg in
      *"Not authenticated"*|*"no longer valid"*|*"Unauthenticated"*|*"401"*)
        emit_auth_error "Not signed in to Laravel Cloud." unauthenticated ;;
      *"Invalid API token"*)
        if [[ -n ${LARAVEL_CLOUD_TOKEN:-} ]]; then
          emit_auth_error "LARAVEL_CLOUD_TOKEN is not a valid Laravel Cloud API token."
        fi
        emit_auth_error "Stored Laravel Cloud token is no longer valid. Sign in again." unauthenticated ;;
    esac
    emit_error "${msg:-cloud application:list failed}"
  fi
fi

# One deployment:list per environment, all in parallel — each call is ~1s.
while IFS=$'\t' read -r env_id idx; do
  [[ -n $env_id ]] || continue
  (
    (( idx >= 0 )) && use_token_index "$idx"
    if out=$(run_cloud deployment:list "$env_id" --json --fields="$DEPLOY_FIELDS"); then
      jq -c 'if type == "array" then (.[0] // null) else null end' <<<"$out" >"$tmp/env-$(slugify "$env_id").json" 2>/dev/null
    fi
  ) &
done < <(jq -r '.[] | .tokenIndex as $t | .environments[]? | [.id, $t] | @tsv' <<<"$apps")
wait

latest='{}'
for f in "$tmp"/env-*.json; do
  [[ -f $f ]] || continue
  id=$(basename "$f" .json); id=${id#env-}
  entry=$(jq -c --arg id "$id" '{($id): .}' "$f" 2>/dev/null) || continue
  latest=$(jq -c --argjson e "$entry" '. + $e' <<<"$latest")
done

result=$(jq -c --argjson latest "$latest" --arg now "$NOW" --argjson setup "$SETUP" '{
  fetchedAt: $now,
  error: null,
  code: null,
  setup: $setup,
  organizations: (map({id: .organization.id, name: .organization.name, slug: .organization.slug, tokenIndex}) | unique_by(.id)),
  apps: map({
    id, name, slug, region, repositoryFullName, repositoryBranch, organization, tokenIndex,
    environments: ((.environments // []) | map(. + { latest: ($latest[(.id | tostring)] // null) }))
  })
}' <<<"$apps") || emit_error "failed to assemble status"

rm -f "$AUTH_RETRY"

if [[ -f $STATE_DIR/setup-pending ]]; then
  notify_setup "Laravel Cloud is ready" "Setup is complete."
  rm -f "$STATE_DIR/setup-pending"
fi

printf '%s\n' "$result" >"$CACHE.tmp" && mv -f "$CACHE.tmp" "$CACHE"
printf '%s\n' "$result"
